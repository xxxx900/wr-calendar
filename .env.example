# Backend-only local configuration. Copy to .env and replace every value.
# Never commit real values to this file.
OPENAI_API_KEY=<your-openai-api-key>
SUPABASE_ADMIN_URL=postgresql://postgres:<password>@db.<your-supabase-ref>.supabase.co:5432/postgres
# Must connect as the chat_reader LOGIN role (see supabase/migrations/006_security_hardening.sql), not readonly_app.
SUPABASE_READONLY_URL=postgresql://<readonly-user>:<password>@db.<your-supabase-ref>.supabase.co:5432/postgres
SUPABASE_URL=https://<your-supabase-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_JWT_SECRET=<your-supabase-jwt-secret>
ADMIN_EMAILS=admin1@example.com,admin2@example.com
UPSTASH_REDIS_REST_URL=https://<your-redis-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-upstash-redis-rest-token>
FRONTEND_ORIGIN=http://localhost:3000
