# ==============================================================================
# Wolf Ranch Community Calendar - Test (UAT) Environment Configuration
# ==============================================================================
# Copy this file to .env.test and fill in your test / staging environment values.
#
# To sync secrets from this file to Google Cloud Secret Manager:
#   .\deploy.ps1 -Environment test -SyncSecrets
#
# To deploy test frontend and backend:
#   .\deploy.ps1 -Environment test -Version v9
# ==============================================================================

# --- Frontend Build Arguments (Baked into Next.js client bundle) ---
# Replace with your test Cloud Run URLs and test Supabase project keys
NEXT_PUBLIC_API_URL=https://calendar-backend-test-997634076075.us-central1.run.app
NEXT_PUBLIC_APP_URL=https://calendar-frontend-test-997634076075.us-central1.run.app
NEXT_PUBLIC_SUPABASE_URL=https://<your-test-supabase-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-test-supabase-anon-key>

# --- Backend Environment Variables ---
FRONTEND_ORIGIN=https://calendar-frontend-test-997634076075.us-central1.run.app

# --- Backend Secrets (Synced to GCP Secret Manager with _TEST suffix) ---
# 1. AI Provider
# Leave blank to reuse production OPENAI_API_KEY in Secret Manager, or specify a test key
OPENAI_API_KEY=

# 2. Supabase (Test Project)
SUPABASE_URL=https://<your-test-supabase-ref>.supabase.co
SUPABASE_ADMIN_URL=postgresql://postgres:<password>@db.<your-test-supabase-ref>.supabase.co:5432/postgres
SUPABASE_READONLY_URL=postgresql://postgres:<password>@db.<your-test-supabase-ref>.supabase.co:5432/postgres
SUPABASE_SERVICE_ROLE_KEY=<your-test-supabase-service-role-key>
SUPABASE_JWT_SECRET=<your-test-supabase-jwt-secret>

# 3. Upstash Redis (Test Database)
UPSTASH_REDIS_REST_URL=https://<your-test-redis-instance>.upstash.io
UPSTASH_REDIS_REST_TOKEN=<your-test-redis-rest-token>
